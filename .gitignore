# dependencies & build outputs
node_modules/
dist/
*.tsbuildinfo
*.local

# local env & logs (contract addresses live in .env.example; keys never in repo)
.env
.env.*
!.env.example
*.log

# contract build artifacts (sources + deployed-address annotations stay in .cdm/solidity)
contract/artifacts/
contract/cache/
contract/target/
contract/bin/

# local tooling config (removed from the repo on GitHub — keep it out)
.claude/
*.log

# OS noise
Thumbs.db
.DS_Store

# verification screenshots — regenerable by each app's tools/look.mjs, and not
# what ships. Anything a user sees lives under public/ (dotmetrics/public/shots
# is committed by the nightly workflow and must stay tracked).
arcadeonchain/shots/
gameboyonchain/shots/
nesonchain/shots/

# polkadot-forum: the imported Discourse archive is derived data (~47 MB).
# Regenerate with `npm run import`; the published copy lives on Bulletin.
polkadot-forum/public/forum-index.json
polkadot-forum/public/forum-home.json
polkadot-forum/public/t-*.json
